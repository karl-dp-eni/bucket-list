{% extends 'base.html.twig' %}

{% block body %}

    <div class="card text-center">
        <div class="card-header">
            Souhait n°{{ wish.id }}
        </div>
        <div class="card-body">
            <h5 class="card-title">{{ wish.title }}</h5>
            <p class="card-text">[{{ wish.category.name }}]</p>
            <p class="card-text">{{ wish.description }}</p>
            <a href="#" class="btn btn-primary">J'ai réalisé ce souhait !</a>
        </div>
        <div class="card-footer text-body-secondary">
            Créé par {{ wish.user.userIdentifier }} le {{ wish.dateCreated | date('d/m/Y') }} à {{ wish.dateCreated | date('H:i') }}
            {% if wish.dateUpdated %}
                <p>Modifié le {{ wish.dateUpdated | date('d/m/Y') }} à {{ wish.dateUpdated| date('H:i') }}</p>
            {% endif %}
        </div>
        {% if app.user %}
        <div>
            <p>
                {% if is_granted('WISH_DELETE', wish) %}
                <a href="{{ path('wish_delete', {'id' : wish.id}) }}">
                    <button>Delete</button>
                </a>
                {% endif %}
                {% if is_granted('WISH_EDIT', wish) %}
                <a href="{{ path('wish_update', {'id': wish.id}) }}">
                    <button>Update</button>
                </a>
                {% endif %}
            </p>
        </div>
        {% endif %}

    </div>
{% endblock %}

{% block title %}
    {{ parent() }} | Detail
{% endblock %}

